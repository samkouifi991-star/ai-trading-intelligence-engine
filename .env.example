# ── LLM (AI News Understanding Engine) ─────────────────────────────────────
# Used only to turn raw headlines into structured JSON (causal chain, asset
# impact scores, etc). All trade decisions are made by deterministic code in
# src/lib/scoring — the LLM is never allowed to decide TRADE/WATCH/NO TRADE.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Learning database ───────────────────────────────────────────────────────
# SQLite file path. Swap for a Postgres/Supabase DSN later by reimplementing
# src/lib/db/db.ts behind the same repository.ts interface.
TRADING_DB_PATH=./data/trading.db

# ── Forex Factory ingestion ─────────────────────────────────────────────────
# Forex Factory has no public REST API. In production this system expects you
# to point it at whichever licensed/structured calendar feed you have access
# to (e.g. a paid ff calendar mirror, or your own scraper service) via this
# URL. Left blank, the calendar connector serves realistic sample fixtures so
# the rest of the pipeline (surprise engine, scoring, dashboards) is fully
# exercisable without credentials. See src/lib/ingestion/README.md.
FOREX_FACTORY_CALENDAR_URL=
FOREX_FACTORY_NEWS_URL=

# Inbound email ingestion (Forex Factory email alerts). Point your email
# provider's inbound-parse webhook (Mailgun, SendGrid, Postmark, etc.) at
# POST /api/ingest/email on this app, and set a shared secret to authenticate
# the webhook call.
INBOUND_EMAIL_WEBHOOK_SECRET=

# ── Market data ──────────────────────────────────────────────────────────
# Any OHLCV/quote provider works (broker API, Polygon, Twelve Data, etc).
# Left blank, src/lib/ingestion/marketData.ts serves a deterministic seeded
# random-walk sample feed so the technical/cross-asset engines are fully
# exercisable in development.
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=

# Cron authentication — required to call /api/cron/tick from an external
# scheduler (Vercel Cron, cron-job.org, etc.)
CRON_SECRET=
