# ── LLM (AI News Understanding Engine) ─────────────────────────────────────
# Used only to turn raw headlines into structured JSON (causal chain, asset
# impact scores, etc). All trade decisions are made by deterministic code in
# src/lib/scoring — the LLM is never allowed to decide TRADE/WATCH/NO TRADE.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Learning database ───────────────────────────────────────────────────────
# SQLite file path. Swap for a Postgres/Supabase DSN later by reimplementing
# src/lib/db/db.ts behind the same repository.ts interface.
TRADING_DB_PATH=./data/trading.db

# ── Forex Factory calendar + breaking news ──────────────────────────────────
# Forex Factory itself has no public REST API. By default:
#  - Calendar: fetched live, keyless, from faireconomy.media's public JSON
#    mirror of FF's own calendar data (real data, no config needed).
#  - Breaking news: FF exposes no public news feed at all. ForexLive's public
#    RSS is used as the default live breaking-news wire instead — a real,
#    keyless forex/macro news source, clearly labeled as ForexLive (not
#    mislabeled as Forex Factory) everywhere it appears.
# Leave both blank to use those defaults. Set either to point at a licensed
# Forex Factory feed (or any other JSON headline API) instead — see
# src/lib/ingestion/README.md for the expected schema.
FOREX_FACTORY_CALENDAR_URL=
FOREX_FACTORY_NEWS_URL=

# Inbound email ingestion (Forex Factory email alerts, webhook path). Point
# your email provider's inbound-parse webhook (Mailgun, SendGrid, Postmark,
# etc.) at POST /api/ingest/email on this app, and set a shared secret to
# authenticate the webhook call. This is an alternative to the Gmail OAuth
# path below — use whichever fits how you actually receive FF alerts.
INBOUND_EMAIL_WEBHOOK_SECRET=

# ── Gmail Forex Factory alert ingestion (OAuth) ─────────────────────────────
# Real Gmail API integration: connect the Gmail account that receives Forex
# Factory's "email me when..." alerts, and every cron tick polls it and feeds
# new alert emails straight into the news-analysis pipeline. Setup:
#  1. Create an OAuth 2.0 Client ID (type: Web application) in a Google Cloud
#     project — console.cloud.google.com/apis/credentials — with the Gmail
#     API enabled.
#  2. Add this app's callback URL as an authorized redirect URI, e.g.
#     https://<your-deployment>/api/gmail/callback (or
#     http://localhost:3000/api/gmail/callback for local dev), and set it below.
#  3. Fill in the client ID/secret, deploy, then visit /api/gmail/connect once
#     to grant access — the refresh token is stored in the database, not here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Gmail search query used to find FF alert emails (Gmail search syntax).
# GMAIL_FF_QUERY=from:forexfactory.com

# ── Market data ──────────────────────────────────────────────────────────
# Live by default and keyless: Yahoo Finance's public chart API for
# XAUUSD/ES/NQ/WTI/FX pairs/DXY/VIX, and FRED (Federal Reserve Economic Data)
# for US2Y/US10Y treasury yields. Set both of these to use a premium vendor
# (broker API, Polygon, Twelve Data, ...) instead.
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=

# Cron authentication — required to call /api/cron/tick from an external
# scheduler (Vercel Cron, cron-job.org, etc.)
CRON_SECRET=
